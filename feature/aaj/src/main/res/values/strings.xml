    <!-- Explain sheet -->
    <string name="aaj_explain_title">How today\'s timings are worked out</string>
    <string name="aaj_explain_body">Your device computes the Sun and Moon positions for your city and finds sunrise, sunset and when each tithi, nakshatra, yoga and karana changes. Nothing is sent anywhere.</string>
    <string name="aaj_explain_how">Windows such as Rahu kaal divide the daylight into equal parts by weekday. Good time is the choghadiya Amrit, Shubh and Labh, plus Abhijit muhurta, with the waiting windows removed.</string>
    <string name="aaj_explain_tradition">Which windows count as good is a traditional rule of thumb. Families and regions differ. You can change the calculation conventions in Settings.</string>
    <string name="aaj_proof_difference_note">Times can differ from other apps by about 1 minute because of sunrise convention, refraction, altitude and ephemeris.</string>
    <string name="aaj_proof_backend_precision">JPL DE440 (high precision)</string>
    <string name="aaj_proof_backend_base">Astronomy Engine (base)</string>
    <string name="aaj_proof_backend_unknown">Not reported</string>
    <string name="aaj_proof_sunrise_upper_limb">Upper edge of the Sun on the refracted horizon</string>
    <string name="aaj_proof_sunrise_center_refracted">Centre of the Sun on the refracted horizon</string>
    <string name="aaj_proof_sunrise_center_geometric">Centre of the Sun on the geometric horizon</string>
