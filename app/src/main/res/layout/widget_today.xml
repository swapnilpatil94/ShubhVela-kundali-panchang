<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:minHeight="48dp"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:padding="16dp">
    <ImageView
        android:id="@+id/today_gem_bar"
        android:layout_width="32dp"
        android:layout_height="3dp"
        android:importantForAccessibility="no"
        android:background="@color/pp_widget_accent" />
    <TextView
        android:id="@+id/today_title"
        android:fontFamily="serif"
        android:textStyle="normal"
        android:layout_marginBottom="4dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/pp_widget_text"
        android:textSize="24sp"
        android:ellipsize="end"
        android:layout_marginTop="2dp"
        android:maxLines="1" />
    <TextView
        android:id="@+id/today_tithi"
        android:fontFeatureSettings="lnum, tnum"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/pp_widget_text"
        android:textSize="17sp"
        android:ellipsize="end"
        android:layout_marginTop="2dp"
        android:maxLines="1" />
    <TextView
        android:id="@+id/today_nakshatra"
        android:fontFeatureSettings="lnum, tnum"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/pp_widget_text"
        android:textSize="17sp"
        android:ellipsize="end"
        android:layout_marginTop="2dp"
        android:maxLines="1" />
    <TextView
        android:id="@+id/today_sun"
        android:fontFeatureSettings="lnum, tnum"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/pp_widget_text_dim"
        android:textSize="15sp"
        android:ellipsize="end"
        android:layout_marginTop="2dp"
        android:maxLines="1" />
    <TextView
        android:id="@+id/today_next"
        android:fontFeatureSettings="lnum, tnum"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/pp_widget_accent"
        android:textSize="15sp"
        android:ellipsize="end"
        android:layout_marginTop="6dp"
        android:maxLines="2" />
    <TextView
        android:id="@+id/today_city"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/pp_widget_text_dim"
        android:textSize="13sp"
        android:ellipsize="end"
        android:layout_marginTop="2dp"
        android:maxLines="1" />
</LinearLayout>
